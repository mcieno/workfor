WF_CPUS=6
WF_MEMORY=12G
WF_DISK=100G
WF_IMAGE=ubuntu:26.04
# VM login account and its UID and primary GID.
WF_USER=ubuntu
WF_UID=1000
WF_GID=1000
# Path on the host where to backup workspace folders.
WF_BACKUP_PATH="${HOME}/Workspaces"
# Optional public key to add to the VM user's SSH authorized keys.
WF_AUTHORIZED_KEY=""
